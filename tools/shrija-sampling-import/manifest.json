{
  "manifest_version": 3,
  "name": "Shrija Sampling Import",
  "version": "1.0.0",
  "description": "Reads the open Manak View Sampling Details page and, after confirmation, fills Job Number and Sample Tag ID on the Shrija QM Request List.",
  "key": "",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://huid.manakonline.in/*",
    "https://shrija-web-software.vercel.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://huid.manakonline.in/*"],
      "js": ["dist/content-manak.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shrija-web-software.vercel.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content-shrija.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://shrija-web-software.vercel.app/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "action": {
    "default_title": "Read Sampling Details",
    "default_popup": "popup.html"
  }
}
