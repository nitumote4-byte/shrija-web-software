{
  "manifest_version": 3,
  "name": "Shrija CG & Cornet (Manak Fill)",
  "version": "2.8.7",
  "description": "Fills Manak Fire Sheet from Shrija. Fill runs only on sampling/assay pages.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://huid.manakonline.in/*",
    "https://newmanak.uat.dcservices.in/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["main-world-bypass.js"],
      "matches": [
        "https://huid.manakonline.in/*",
        "https://newmanak.uat.dcservices.in/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-shrija.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://huid.manakonline.in/*Samplingweighting*",
        "https://huid.manakonline.in/*assaying*",
        "https://huid.manakonline.in/*Assaying*",
        "https://newmanak.uat.dcservices.in/*Samplingweighting*",
        "https://newmanak.uat.dcservices.in/*assaying*",
        "https://newmanak.uat.dcservices.in/*Assaying*"
      ],
      "js": ["main-world-bypass.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://huid.manakonline.in/*Samplingweighting*",
        "https://huid.manakonline.in/*assaying*",
        "https://huid.manakonline.in/*Assaying*",
        "https://newmanak.uat.dcservices.in/*Samplingweighting*",
        "https://newmanak.uat.dcservices.in/*assaying*",
        "https://newmanak.uat.dcservices.in/*Assaying*"
      ],
      "js": ["manak-fill-lib.js", "content-manak.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Shrija CG & Cornet",
    "default_popup": "popup.html"
  }
}
