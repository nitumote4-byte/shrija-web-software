# Copy to .env for local development (never commit .env)
# npm run dev (from repo root) starts Docker Postgres + this API + the UI.

# PostgreSQL — Railway: use the Postgres service DATABASE_URL
# Local Docker: postgresql://shrija:shrija@localhost:5432/shrija
DATABASE_URL=postgresql://shrija:shrija@localhost:5432/shrija

# Required in production — at least 32 characters, and not a placeholder.
# JWT_SECRET, LICENSE_MASTER_SECRET, and MANAK_ENCRYPTION_KEY must all differ.
JWT_SECRET=change-me-to-a-long-random-secret

# Required in production — must be different from JWT_SECRET
LICENSE_MASTER_SECRET=change-me-separate-from-jwt

# Required in production — encrypts stored Manak passwords. Never reuse JWT_SECRET.
MANAK_ENCRYPTION_KEY=change-me-manak-encryption-key-not-jwt

# Comma-separated frontend origins (Vercel URL)
CORS_ORIGIN=http://localhost:5173

PORT=8787
NODE_ENV=development

# Temporary maintenance screen for the web app (read on each API request).
# ON: 1, true, yes, or on. OFF: unset, false, 0, or off.
# Changing this does not require a frontend rebuild. Restart the API after changing it.
# MAINTENANCE_MODE=off

# Set to false only for local Postgres without SSL
PGSSL=false

# Frontend origin used in password-reset emails
FRONTEND_URL=http://localhost:5173

# SMTP — Resend (https://resend.com). Do not commit the API key.
# Railway production values:
#   FRONTEND_URL=https://shrija-web-software.vercel.app
#   CORS_ORIGIN=https://shrija-web-software.vercel.app
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USER=resend
#   MAIL_PASSWORD=          # Resend API key (re_...)
#   MAIL_FROM=Shrija Hallmark Suite <verified-sender@your-domain>
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASSWORD=
MAIL_FROM=Shrija Hallmark Suite <verified-sender@your-domain>
