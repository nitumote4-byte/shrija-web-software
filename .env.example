# Frontend (Vercel)
# Leave VITE_API_URL empty — browser uses same-origin /api (proxied by api/[...path].js)
# Optional: Railway URL override for the serverless proxy
# RAILWAY_API_URL=https://shrija-web-software-production.up.railway.app

# Backend (Railway)
# JWT_SECRET=long-random-string
# LICENSE_MASTER_SECRET=separate-secret-for-issuing-keys
# DATABASE_URL=postgresql://...
# FRONTEND_URL=https://shrija-web-software.vercel.app
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USER=resend
# MAIL_PASSWORD=          # Resend API key — set on Railway only, never commit
# MAIL_FROM=Shrija Hallmark Suite <verified-sender@your-domain>
